# Banco SQLite do servidor. Caminho relativo a server/prisma/.
DATABASE_URL="file:./dev.db"

# Segredo do JWT de sessao. Use um valor longo e aleatorio em cada instalacao.
AUTH_SECRET="troque-este-valor"

# Porta da API. O Vite faz proxy de /api para ela.
PORT=3001

# Credenciais criadas pelo seed. Troque antes de rodar em rede.
SEED_ADMIN_LOGIN="ADMIN"
SEED_ADMIN_SENHA="piumobile"
SEED_USER_SENHA="piumobile"
